                                  <div class="tooltip-content" style="top: {{ block.settings.tooltip-item-3-top-bottom }}%; left: {{ block.settings.tooltip-item-3 }}%;">
                                    <div class="product-detial-tooltip">
                                      <div class="product-image">
                                          <a href="{{ tooltip_product_3.url }}">
                                            <img class="prod-img" src="{{ tooltip_product_3.featured_image | img_url: 'master' }}" alt="{{ tooltip_product_3.title | escape }}">  
                                          </a>
                                      </div>
                                      <div class="product-det">
                                          <a class="prod-title" href="{{ tooltip_product_3.url }}">
                                            <h6>{{ tooltip_product_3.title }}</h6>
                                          </a>

                                          <span class="price"> {{ tooltip_product_3.price | money }}</span>

                                          {% if tooltip_product_3.variants.size > 1 %}
                                            <form method="post" action="/cart/add" id="add-to-cart-form-{{ tooltip_product_3.id }}" data-product-handle="{{ tooltip_product_3.handle }}">
                                              {% for option in tooltip_product_3.options_with_values %}
                                                <div class="product-option">
                                                  <label>{{ option.name }}</label>
                                                  
                                                  {% if option.name == "Color" %}
                                                    <!-- Color Swatches -->
                                                    <div class="color-swatches">
                                                      {% for value in option.values %}
                                                        <div class="color-swt">
                                                          <input 
                                                            type="radio" 
                                                            id="color-{{ value | handle }}" 
                                                            name="options[Color]" 
                                                            value="{{ value | escape }}"
                                                            {% if forloop.first %}checked{% endif %}
                                                          >
                                                          <label for="color-{{ value | handle }}" style="background-color: {{ value | handle }}; display: inline-block;"></label>
                                                        </div>
                                                      {% endfor %}
                                                    </div>
                                                  {% else %}
                                                    <!-- Other options (e.g., Size) as dropdown -->
                                                    <select name="options[{{ option.name | escape }}]">
                                                      {% for value in option.values %}
                                                        <option value="{{ value | escape }}">{{ value }}</option>
                                                      {% endfor %}
                                                    </select>
                                                  {% endif %}
                                                </div>
                                              {% endfor %}


                                              {% if tooltip_product_3.available %}
                                                <input type="hidden" name="id" value="{{ tooltip_product_3.variants.first.id }}">
                                                <button type="submit" class="add-t-cart">Add to Cart</button>
                                              {% else %}
                                              <button class="add-t-cart" disabled>Out of Stock</button>
                                              {% endif %}
                                            </form>
                                          {% else %}
                                            <form method="post" action="/cart/add" id="add-to-cart-form-{{ tooltip_product_3.id }}" data-product-handle="{{ tooltip_product_3.handle }}">
                                              {% if tooltip_product_3.available %}
                                                <input type="hidden" name="id" value="{{ tooltip_product_3.variants.first.id }}">
                                                <button type="submit" class="add-t-cart">Add to Cart</button>
                                              {% else %}
                                                <button class="add-t-cart" disabled>Out of Stock</button>
                                              {% endif %}
                                            </form>
                                          {% endif %}
                                      </div>
                                  </div>
