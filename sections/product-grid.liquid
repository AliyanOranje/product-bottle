<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
    <product-grid>
        <div class="product-grid-m-div">
            {% if section.blocks.size > 0 %}
                <div class="product-grid-row">
                    {% for block in section.blocks %}
                    {%- assign tooltip_product_1 = all_products[block.settings.tooltip_product_handle_1] -%}
                    {%- assign tooltip_product_2 = all_products[block.settings.tooltip_product_handle_2] -%}
                    {%- assign tooltip_product_3 = all_products[block.settings.tooltip_product_handle_3] -%}


                        {% if tooltip_product_1 %}
                        <div class="product-grid-item">
                            <div class="product-image-m-div">
                              {%- if block.settings.main_image !=blank -%}
                                <img src="{{ block.settings.main_image  | image_url }}">
                              {%- endif -%}

                              {%- if tooltip_product_1 != blank -%}
                              <div class="tolltip-item-m-div">
                                  <button class="tooltip-btn" style="top: {{ block.settings.tooltip-item-1-top-bottom }}%; left: {{ block.settings.tooltip-item-1 }}%;"></button>
                                  <div class="tooltip-content" style="top: {{ block.settings.tooltip-item-1-top-bottom }}%; left: {{ block.settings.tooltip-item-1 }}%;">
                                    <div class="product-detial-tooltip">
                                      <div class="product-image">
                                          <a href="{{ tooltip_product_1.url }}">
                                            <img class="prod-img" src="{{ tooltip_product_1.featured_image | img_url: 'master' }}" alt="{{ tooltip_product_1.title | escape }}">  
                                          </a>
                                      </div>
                                      <div class="product-det">
                                          <a class="prod-title" href="{{ tooltip_product_1.url }}">
                                            <h6>{{ tooltip_product_1.title }}</h6>
                                          </a>

                                          <span class="price"> {{ tooltip_product_1.price | money }}</span>

                                          {% if tooltip_product_1.variants.size > 1 %}
                                            <form method="post" action="/cart/add" id="add-to-cart-form-{{ tooltip_product_1.id }}" data-product-handle="{{ tooltip_product_1.handle }}">
                                              {% for option in tooltip_product_1.options_with_values %}
                                                <div class="product-option">
                                                  <label>{{ option.name }}</label>

                                                  {% if option.name == "Color" %}
                                                    <!-- Color Swatches -->
                                                    <div class="color-swatches">
                                                      {% for value in option.values %}
                                                        <div class="color-swt">
                                                          <input type="radio" id="color-{{ value | handle }}" name="options[Color]" value="{{ value | escape }}" {% if forloop.first %}checked{% endif %}>
                                                          <label for="color-{{ value | handle }}" style="background-color: {{ value | handle }}; display: inline-block;"></label>
                                                        </div>
                                                      {% endfor %}
                                                    </div>
                                                  {% else %}
                                                    <!-- Other options (e.g., Size) as dropdown -->
                                                    <select name="options[{{ option.name | escape }}]" id="size-{{ tooltip_product_1.id }}">
                                                      {% for value in option.values %}
                                                        <option value="{{ value | escape }}" {% if forloop.first %}selected{% endif %}>{{ value }}</option>
                                                      {% endfor %}
                                                    </select>
                                                  {% endif %}
                                                </div>
                                              {% endfor %}

                                              {% if tooltip_product_1.available %}
                                                <button type="submit" class="add-t-cart">Add to Cart</button>
                                              {% else %}
                                                <button class="add-t-cart" disabled>Out of Stock</button>
                                              {% endif %}
                                            </form>
                                          {% else %}
                                            <form method="post" action="/cart/add" id="add-to-cart-form-{{ tooltip_product_1.id }}" data-product-handle="{{ tooltip_product_1.handle }}">
                                              {% if tooltip_product_1.available %}
                                                <input type="hidden" name="id" value="{{ tooltip_product_1.variants.first.id }}">
                                                <button type="submit" class="add-t-cart">Add to Cart</button>
                                              {% else %}
                                                <button class="add-t-cart" disabled>Out of Stock</button>
                                              {% endif %}
                                            </form>
                                          {% endif %}
                                      </div>
                                  </div>
                                  </div>
                              </div>
                              {%- endif -%}
                              

                              {%- if tooltip_product_2 != blank -%}
                              <div class="tolltip-item-m-div">
                                  <button class="tooltip-btn" style="top: {{ block.settings.tooltip-item-2-top-bottom }}%; left: {{ block.settings.tooltip-item-2 }}%;"></button>
                                  <div class="tooltip-content" style="top: {{ block.settings.tooltip-item-2-top-bottom }}%; left: {{ block.settings.tooltip-item-2 }}%;">
                                    <div class="product-detial-tooltip">
                                      <div class="product-image">
                                          <a href="{{ tooltip_product_2.url }}">
                                            <img class="prod-img" src="{{ tooltip_product_2.featured_image | img_url: 'master' }}" alt="{{ tooltip_product_2.title | escape }}">  
                                          </a>
                                      </div>
                                      <div class="product-det">
                                          <a class="prod-title" href="{{ tooltip_product_2.url }}">
                                            <h6>{{ tooltip_product_2.title }}</h6>
                                          </a>

                                          <span class="price"> {{ tooltip_product_2.price | money }}</span>

                                          {% if tooltip_product_2.variants.size > 1 %}
                                            <form method="post" action="/cart/add" id="add-to-cart-form-{{ tooltip_product_2.id }}" data-product-handle="{{ tooltip_product_2.handle }}">
                                              {% for option in tooltip_product_2.options_with_values %}
                                                <div class="product-option">
                                                  <label>{{ option.name }}</label>
                                                  
                                                  {% if option.name == "Color" %}
                                                    <!-- Color Swatches -->
                                                    <div class="color-swatches">
                                                      {% for value in option.values %}
                                                        <div class="color-swt">
                                                          <input 
                                                            type="radio" 
                                                            id="color-{{ value | handle }}" 
                                                            name="options[Color]" 
