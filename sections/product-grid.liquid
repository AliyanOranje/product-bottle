<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
    <product-grid>
        <div class="product-grid-m-div">
            {% if section.blocks.size > 0 %}
                <div class="product-grid-row">
                    {% for block in section.blocks %}
                    {% assign showcase_product = all_products[block.settings.product_handle] %}
                        {% if showcase_product %}
                        <div class="product-grid-item">
                            <div class="product-image-m-div">
                              {%- if block.settings.main_image !=blank -%}
                                <img src="{{ block.settings.main_image  | image_url }}">
                              {%- endif -%}
                              {%- if block.settings.tooltip_product_handle_1 !=blank -%}
                                <div class="hotspot" style="top: {{ block.settings.tooltip-item-1-top-bottom }}%; left: {{ block.settings.tooltip-item-1 }}%;">
                                    <div class="tooltip">
                                        <div class="product-detial-tooltip">
                                            <div class="product-image">
                                                <a href="{{ showcase_product.url }}">
                                                    <img class="prod-img" src="{{ showcase_product.featured_image | img_url: block.settings.image_size }}" alt="{{ showcase_product.title | escape }}">
                                                </a>
                                            </div>
                                            <div class="product-det">
                                                <a href="{{ showcase_product.url }}">
                                                    <h6>{{ block.settings.heading | default: showcase_product.title }}Test</h6>
                                                </a>
                                                <span class="price"> {{ showcase_product.price | money }} $200</span>
                                                <button class="add-t-cart">Add to Cart</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                              {%- endif -%}


                              {%- if block.settings.tooltip_product_handle_2 !=blank -%}
                                <div class="hotspot" style="top: {{ block.settings.tooltip-item-2-top-bottom }}%; left: {{ block.settings.tooltip-item-2 }}%;">
                                    <div class="tooltip">
                                        <div class="product-detial-tooltip">
                                            <div class="product-image">
                                                <a href="{{ showcase_product.url }}">
                                                    <img class="prod-img" src="{{ showcase_product.featured_image | img_url: block.settings.image_size }}" alt="{{ showcase_product.title | escape }}">
                                                </a>
                                            </div>
                                            <div class="product-det">
                                                <a href="{{ showcase_product.url }}">
                                                    <h6>{{ block.settings.heading | default: showcase_product.title }}Test</h6>
                                                </a>
                                                <span class="price"> {{ showcase_product.price | money }} $200</span>
                                                <button class="add-t-cart">Add to Cart</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                              {%- endif -%}
                             
                              {%- if block.settings.tooltip_product_handle_3 !=blank -%}
                                <div class="hotspot" style="top: {{ block.settings.tooltip-item-3-top-bottom }}%; left: {{ block.settings.tooltip-item-3 }}%;">
                                    <div class="tooltip">
                                        <div class="product-detial-tooltip">
                                            <div class="product-image">
                                                <a href="{{ showcase_product.url }}">
                                                    <img class="prod-img" src="{{ showcase_product.featured_image | img_url: block.settings.image_size }}" alt="{{ showcase_product.title | escape }}">
                                                </a>
                                            </div>
                                            <div class="product-det">
                                                <a href="{{ showcase_product.url }}">
                                                    <h6>{{ block.settings.heading | default: showcase_product.title }}Test</h6>
                                                </a>
                                                <span class="price"> {{ showcase_product.price | money }} $200</span>
                                                <button class="add-t-cart">Add to Cart</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                              {%- endif -%}

                            </div>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </product-grid>
</div>





<script type="text/javascript">
    document.querySelectorAll('.hotspot').forEach(hotspot => {
        hotspot.addEventListener('click', e => {
            hotspot.classList.toggle('active');

            document.querySelectorAll('.hotspot').forEach(other => {
                if (other !== hotspot) other.classList.remove('active');
            });
            e.stopPropagation();
        });
    });
    document.addEventListener('click', () =>{
        document.querySelectorAll('.hotspot.active').forEach(h => h.classList.remove('active'));
    });
</script>



{% schema %}
{
  "name": "product grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "main_image",
          "label": "Upload Image"
        },
        {
          "type": "product",
          "id": "product_handle",
          "label": "Select product"
        },
        {
          "type": "header",
          "content": "Tool Tip Item 1"
        },
        {
          "type": "product",
          "id": "tooltip_product_handle_1",
          "label": "Select Tooltip product"
        },
        {
          "type": "range",
          "id": "tooltip-item-1",
          "label": "Tool Tip Item 1 Left & Right",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 20
        },
        {
          "type": "range",
          "id": "tooltip-item-1-top-bottom",
          "label": "Tool Tip Item 1 top & Bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 20
        },
        {
          "type": "header",
          "content": "Tool Tip Item 2"
        },
        {
          "type": "product",
          "id": "tooltip_product_handle_2",
          "label": "Select Tooltip product"
        },
        {
          "type": "range",
          "id": "tooltip-item-2",
          "label": "Tool Tip Item 2 Left & Right",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 20
        },
        {
          "type": "range",
          "id": "tooltip-item-2-top-bottom",
          "label": "Tool Tip Item 2 top & Bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 20
        },
        {
          "type": "header",
          "content": "Tool Tip Item 3"
        },
        {
          "type": "product",
          "id": "tooltip_product_handle_3",
          "label": "Select Tooltip product"
        },
        {
          "type": "range",
          "id": "tooltip-item-3",
          "label": "Tool Tip Item 3 Left & Right",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 20
        },
        {
          "type": "range",
          "id": "tooltip-item-3-top-bottom",
          "label": "Tool Tip Item 3 top & Bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 20
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "product grid"
    }
  ]
}
{% endschema %}