                                                        </div>
                                                      {% endfor %}
                                                    </div>
                                                  {% else %}
                                                    <!-- Other options (e.g., Size) as dropdown -->
                                                    <select name="options[{{ option.name | escape }}]">
                                                      {% for value in option.values %}
                                                        <option value="{{ value | escape }}">{{ value }}</option>
                                                      {% endfor %}
                                                    </select>
                                                  {% endif %}
