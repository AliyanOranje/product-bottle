                              </div>
                              {%- endif -%}
                            </div>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </product-grid>
</div>


<script>
  class ProductGrid extends HTMLElement {
    constructor() {
      super();
      this.setupAddToCart();
    }

    setupAddToCart() {
      // Event listener for all "Add to Cart" buttons
      const addToCartButtons = this.querySelectorAll('.add-t-cart');
      addToCartButtons.forEach(button => {
        button.addEventListener('click', (event) => {
          event.preventDefault(); // Prevent default form submission

          const form = button.closest('form');
          const color = form.querySelector('input[name="options[Color]"]:checked');
          const size = form.querySelector('select[name="options[Size]"]');

          if (color && size) {
            const selectedColor = color.value;
            const selectedSize = size.value;

            // Get the product handle from the form dataset (ensure it's set)
            const productHandle = form.dataset.productHandle;  // Use product handle instead of ID

            // Fetch the product data
            this.fetchProductData(productHandle)
              .then(product => {
                const variantId = this.getVariantId(selectedColor, selectedSize, product);
                if (variantId) {
                  this.addToCart(variantId);
                } else {
                  alert("Variant not found.");
                }
              })
              .catch(error => {
                alert("Error fetching product data: " + error.message);
              });
          }
        });
      });
    }

    // Helper function to fetch product data from Shopify using the product handle
    fetchProductData(productHandle) {
      return new Promise((resolve, reject) => {
        // Construct the correct URL for the Shopify product API
        const productUrl = `/products/${productHandle}.js`;  // Correct URL for product handle

        fetch(productUrl)
          .then(response => {
            if (!response.ok) {
              throw new Error(`Error fetching product data: ${response.statusText}`);
            }
            return response.json(); // Parse the response as JSON
          })
          .then(product => {
            resolve(product);
          })
          .catch(error => {
            reject('Error fetching product data: ' + error.message);
          });
      });
    }

    // Helper function to find the correct variant ID
    getVariantId(color, size, product) {
      for (const variant of product.variants) {
        if (variant.options.includes(color) && variant.options.includes(size)) {
          return variant.id;
        }
      }
      return null; // Variant not found
    }

    // Function to add the selected item to the cart
    addToCart(variantId) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          items: [{
            id: variantId,
            quantity: 1
          }]
        }),
      })
      .then(response => response.json())
      .then(data => {
        alert("Product added to the cart successfully!");  // Show success message
      })
      .catch(error => {
        alert("Error adding to cart: " + error.message);  // Show error message
      });
    }
  }

  if (!customElements.get('product-grid')) {
    customElements.define('product-grid', ProductGrid);
  }
</script>







<script>
    document.querySelectorAll('.tooltip-btn').forEach(btn => {
        btn.addEventListener('click', e => {
            const tooltip = e.target.nextElementSibling;
            const isTooltipActive = tooltip.classList.contains('active');
            
            document.querySelectorAll('.tooltip-content').forEach(t => {
                t.classList.remove('active');
            });
            
            if(!isTooltipActive){
              tooltip.classList.add('active');
            } else {
              tooltip.classList.remove('active');
            }

            e.stopPropagation();
        });
    });
</script>


